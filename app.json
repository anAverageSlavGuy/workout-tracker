{
  "expo": {
    "name": "Workout Tracker",
    "slug": "workout-tracker",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "scheme": "workout-tracker",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#0a0a0a"
      }
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png",
      "output": "single",
      "manifest": {
        "name": "Workout Tracker",
        "short_name": "Workout",
        "description": "Traccia i tuoi allenamenti e la progressione dei carichi",
        "theme_color": "#07000a",
        "background_color": "#07000a",
        "display": "standalone",
        "orientation": "portrait"
      }
    },
    "plugins": [
      "expo-router"
    ]
  }
}
